# =============================================================================
# JClipper configuration (sample)
# =============================================================================
# Copy this file to .env and edit the values for your setup.
# docker-compose loads it via `env_file`. Do not commit your .env (secrets).

# --- Core paths (internal container paths — map host dirs in the compose volumes) ---
MOVIES_DIR=/movies
TV_SHOWS_DIR=/tv
OUTPUT_DIR=/output

# --- Content ---
# Comma-separated video extensions to scan for.
VIDEO_EXTENSIONS=mp4,mkv,avi,mov,wmv,flv
# Comma-separated folder names to skip when scanning (e.g. @eaDir on Synology,
# System Volume Information on Windows).
EXCLUDED_FOLDERS=
# Preferred subtitle language (ISO code, e.g. en, de, fr).
DEFAULT_LANGUAGE=en

# --- Security ---
# REQUIRED. Flask session secret. Set to a long random string, e.g. `openssl rand -hex 32`.
SECRET_KEY=

# --- Preview encoding ---
# Preview video height in px (width auto-scaled). Lower = faster, smaller previews.
PREVIEW_HEIGHT=360

# --- S3 upload (leave all blank to disable the upload button) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_KEY=
S3_SECRET=
# basic or presigned. presigned is required for Garage (no anonymous access);
# basic links are prettier.
S3_LINK_FORMAT=basic

# --- Logging ---
# Show FFmpeg console output (the final log is already shown on the preview page).
FFMPEG_LOG_ENABLED=false
# Show the directory scan process in the console at startup.
STARTUP_SCAN_LOG_ENABLED=false

# --- Advanced (optional — uncomment to override the built-in defaults) ---
# Working directory for temporary files.
#TEMP_DIR=/tmp/jclipper
# Where preview files are cached.
#PREVIEW_CACHE_DIR=
# Max number of cached previews.
#PREVIEW_MAX_CACHE=20
# Seconds of padding around the clip in the preview.
#PREVIEW_PAD_SECONDS=15
